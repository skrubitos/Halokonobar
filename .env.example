# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# PostgreSQL — use Railway connection string in production
DATABASE_URL=postgresql://postgres:password@localhost:5432/halokonobar

# Redis — use Railway/ElastiCache URL in production
REDIS_URL=redis://localhost:6379

# JWT — MUST be changed in production, minimum 32 chars
JWT_SECRET=change-this-in-production-minimum-32-characters
JWT_EXPIRES_IN=28800

# ─── Object Storage (Cloudflare R2) ──────────────────────────────────────────
S3_BUCKET=halokonobar-assets
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key
S3_SECRET_ACCESS_KEY=your-r2-secret-key
CDN_BASE_URL=https://cdn.halokonobar.com

# ─── Cloudflare (for CDN cache purge on menu changes) ────────────────────────
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-api-token

# ─── Frontend apps ───────────────────────────────────────────────────────────
# These are prefixed VITE_ to be exposed to browser bundles
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
